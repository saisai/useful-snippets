# Production settings for Docker Hub deploy.
# Copy this file and edit values:
#   cp .env_hub.example .env_hub
#
# Then deploy:
#   docker compose --env-file .env_hub pull
#   docker compose --env-file .env_hub up -d

# Docker Hub image (pulled on every deploy)
DOCKER_IMAGE=username/blog:latest

# Public site URL (canonical / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://blog.example.com

# Optional site branding (override image defaults)
NEXT_PUBLIC_SITE_NAME=Knowledge Base
NEXT_PUBLIC_SITE_DESCRIPTION=A collection of useful technical notes, commands, guides and solutions.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_GITHUB_BRANCH=main
