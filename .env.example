# Absolute public URL of the deployed site.
# Used for canonical URLs, Open Graph metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production (behind nginx): NEXT_PUBLIC_SITE_URL="https://example.com"

# Display name shown in the header, metadata titles and Open Graph images.
NEXT_PUBLIC_SITE_NAME="Knowledge Base"

# Short tagline used on the homepage and as the default meta description.
NEXT_PUBLIC_SITE_DESCRIPTION="A collection of useful technical notes, commands, guides and solutions."

# Optional. When set, a source link is shown in the header and an
# "Edit this page" link is shown at the bottom of every document.
NEXT_PUBLIC_GITHUB_URL="https://github.com/saisai/useful-snippets"

# Optional. Branch used to build "Edit this page" links. Defaults to "main".
NEXT_PUBLIC_GITHUB_BRANCH="main"

# Optional. Comma separated list of extra directories (relative to the project
# root) to scan for Markdown documents. Defaults to the project root + "content".
# CONTENT_SOURCES="content,notes"
